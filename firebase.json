{
  "hosting": {
    "site": "syncedlist",
    "public": "build/web",
    "predeploy": ["flutter build web --release"],
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      ".last_build_id",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [{ "key": "Content-Type", "value": "application/json" }]
      },
      {
        "source": "**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ],
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
